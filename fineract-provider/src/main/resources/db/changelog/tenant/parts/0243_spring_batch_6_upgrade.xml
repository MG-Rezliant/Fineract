<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        As per the Spring Batch 6.0 migration scripts shipped in spring-batch-core
        (org/springframework/batch/core/migration/6.0): the job instance sequence
        BATCH_JOB_SEQ was renamed to BATCH_JOB_INSTANCE_SEQ. On MySQL and MariaDB the
        sequence is emulated as a table (see 0021_add_spring_batch_db_structure.xml and
        FineractDataFieldMaxValueIncrementerFactory), so the rename is a table rename there.
    -->
    <changeSet author="fineract" id="1" context="postgresql">
        <sql>
            ALTER SEQUENCE BATCH_JOB_SEQ RENAME TO BATCH_JOB_INSTANCE_SEQ
        </sql>
    </changeSet>
    <changeSet author="fineract" id="1-mysql" context="mysql">
        <sql>
            RENAME TABLE BATCH_JOB_SEQ TO BATCH_JOB_INSTANCE_SEQ
        </sql>
    </changeSet>
</databaseChangeLog>
